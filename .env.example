# Copy to `.env` (git-ignored) and fill in. Read and validated by build.rs at
# compile time; exported shell variables take precedence over this file.

# --- WiFi (2.4 GHz only, CYW43439 has no 5 GHz radio) ---
WIFI_SSID=your-ssid-here
WIFI_PSK=your-passphrase-here          # empty = open network

# --- Upload endpoint ---
ENDPOINT_HOST=sink.example.lan         # hostname (resolved via DHCP-provided DNS) or IPv4 literal
ENDPOINT_PORT=80
ENDPOINT_PATH=/enviro
PAYLOAD_FORMAT=json                    # json | thingspeak

# --- Authentication (pick one) ---
# json:        API_KEY -> "Authorization: Bearer <API_KEY>" (Node-RED, Home Assistant, custom sinks)
# thingspeak:  API_KEY -> channel *write* key, sent as form field api_key
API_KEY=
# HTTP Basic auth (e.g. Telegraf http_listener_v2); overrides the Bearer header.
HTTP_BASIC_USER=
HTTP_BASIC_PASS=

# --- Node ---
NODE_ID=enviro-01                      # [A-Za-z0-9_-]{1,32}, sent in the JSON body
INTERVAL_SECS=300                      # sample + upload period, >= 10
BME280_ADDR=0x76                       # 0x76 (SDO -> GND) or 0x77 (SDO -> 3V3)
